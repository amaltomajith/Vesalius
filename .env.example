# Copy to .env and fill in real values. Never commit the real .env.

# --- Postgres roles (used by migrations/0003_roles_and_grants.py and by app config) ---
POSTGRES_SUPERUSER_PASSWORD=changeme-superuser
PIPELINE_SVC_PASSWORD=changeme-pipeline-svc
SERVING_RO_PASSWORD=changeme-serving-ro

# --- MinIO: one access/secret key pair per zone bucket ---
MINIO_BRONZE_ACCESS_KEY=bronze-access
MINIO_BRONZE_SECRET_KEY=changeme-bronze-secret
MINIO_SILVER_ACCESS_KEY=silver-access
MINIO_SILVER_SECRET_KEY=changeme-silver-secret
MINIO_GOLD_ACCESS_KEY=gold-access
MINIO_GOLD_SECRET_KEY=changeme-gold-secret
MINIO_QUARANTINE_ACCESS_KEY=quarantine-access
MINIO_QUARANTINE_SECRET_KEY=changeme-quarantine-secret

# --- Used by S4 (de-identification) for HMAC-keyed UID remap / date shift / patient
# pseudonym. S4 refuses to run with either empty -- generate real values, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
DEID_UID_SECRET=
DEID_DATE_SHIFT_SECRET=
